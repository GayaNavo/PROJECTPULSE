rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }

    function roleIs(roleName) {
      return hasActiveProfile() && get(userPath(request.auth.uid)).data.role == roleName;
    }

    function isSuperAdmin() {
      return roleIs('super_admin');
    }

    function canViewAllProjects() {
      return isSuperAdmin() || roleIs('ceo');
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function canAccessProject(projectId) {
      let project = get(projectPath(projectId)).data;
      return hasActiveProfile()
        && (canViewAllProjects()
          || project.managerId == request.auth.uid
          || project.memberIds.hasAny([request.auth.uid]));
    }

    function canManageProject(projectId) {
      let project = get(projectPath(projectId)).data;
      return isSuperAdmin()
        || (roleIs('project_manager') && project.managerId == request.auth.uid);
    }

    function validProjectCreate() {
      return hasActiveProfile()
        && (isSuperAdmin() || roleIs('project_manager'))
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.managerName == get(userPath(request.auth.uid)).data.displayName
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'priority', 'startDate', 'targetDate', 'status',
          'managerId', 'managerName', 'memberIds', 'forecastDate', 'createdBy',
          'createdAt', 'updatedAt'
        ]);
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'team_member'
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'active', 'createdAt', 'updatedAt'
        ]);

      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();

      // Elevated roles are provisioned outside the client. A Super Admin cannot
      // change/deactivate a Super Admin through this client workflow. This
      // ensures the system cannot remove its final active Super Admin.
      allow update: if (
          isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'active', 'role', 'updatedAt'
          ])
          && request.resource.data.role in [
            'super_admin', 'ceo', 'project_manager', 'team_lead', 'team_member'
          ]
          && (resource.data.role != 'super_admin'
            || (request.resource.data.role == 'super_admin' && request.resource.data.active == true))
        ) || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastLoginAt', 'updatedAt'
          ])
        );
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow get, list: if hasActiveProfile()
        && (canViewAllProjects()
          || resource.data.managerId == request.auth.uid
          || resource.data.memberIds.hasAny([request.auth.uid]));
      allow create: if validProjectCreate();
      allow update: if canManageProject(projectId)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'priority', 'startDate',
            'forecastDate', 'status', 'updatedBy', 'updatedAt'
          ])
          || (isSuperAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'memberIds', 'updatedBy', 'updatedAt'
            ])));
      // Archive projects instead of deleting historical records.
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if canAccessProject(projectId);
        allow create: if canManageProject(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.keys().hasOnly([
            'projectId', 'title', 'description', 'assigneeId', 'dueDate',
            'priority', 'status', 'progress', 'checklist', 'createdBy',
            'createdAt', 'updatedAt'
          ])
          && (request.resource.data.assigneeId == ''
            || get(projectPath(projectId)).data.memberIds.hasAny([request.resource.data.assigneeId]));
        allow update: if canManageProject(projectId)
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.createdBy == resource.data.createdBy
          || (canAccessProject(projectId)
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'progress', 'checklist', 'updatedAt'
            ]));
        allow delete: if canManageProject(projectId);
      }

      match /activity/{activityId} {
        allow read: if canAccessProject(projectId);
        allow create: if canAccessProject(projectId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName == get(userPath(request.auth.uid)).data.displayName
          && request.resource.data.keys().hasOnly([
            'actorId', 'actorName', 'type', 'message', 'createdAt', 'changes'
          ]);
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if canAccessProject(projectId);
        allow create: if canAccessProject(projectId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(userPath(request.auth.uid)).data.displayName
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'body', 'createdAt'
          ]);
        allow update: if canAccessProject(projectId)
          && (resource.data.authorId == request.auth.uid || canManageProject(projectId))
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt']);
        allow delete: if canAccessProject(projectId)
          && (resource.data.authorId == request.auth.uid || canManageProject(projectId));
      }

      match /milestones/{milestoneId} {
        allow read: if canAccessProject(projectId);
        allow create: if canAccessProject(projectId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.keys().hasOnly([
            'title', 'dueDate', 'notes', 'status', 'ownerId', 'ownerName',
            'createdBy', 'createdAt', 'updatedAt'
          ]);
        allow update: if canManageProject(projectId)
          || (canAccessProject(projectId)
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'notes', 'dueDate', 'updatedAt'
            ]));
        allow delete: if canManageProject(projectId);
      }

      match /blockers/{blockerId} {
        allow read: if canAccessProject(projectId);
        allow create: if canAccessProject(projectId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.keys().hasOnly([
            'title', 'description', 'severity', 'dueDate', 'nextAction', 'status',
            'ownerId', 'ownerName', 'createdBy', 'createdAt', 'updatedAt'
          ]);
        allow update: if canManageProject(projectId)
          || (canAccessProject(projectId)
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'nextAction', 'dueDate', 'updatedAt'
            ]));
        allow delete: if canManageProject(projectId);
      }

      match /supportRequests/{requestId} {
        allow read: if canAccessProject(projectId);
        allow create: if canAccessProject(projectId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.keys().hasOnly([
            'description', 'taskId', 'department', 'category', 'requiredBy',
            'priority', 'status', 'resolutionNotes', 'ownerId', 'ownerName',
            'createdBy', 'createdAt', 'updatedAt'
          ]);
        allow update: if canManageProject(projectId)
          || (canAccessProject(projectId)
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'resolutionNotes', 'requiredBy', 'updatedAt'
            ]));
        allow delete: if canManageProject(projectId);
      }
    }

    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
